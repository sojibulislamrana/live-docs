# ─────────────────────────────────────────────────────────────────────────────
# Environment variables required by live-doc
#
# Copy this file to `.env.local` for local development, and add ALL of these
# variables to your Vercel project (Settings → Environment Variables) before
# deploying. Secrets are never committed to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# Convex (https://dashboard.convex.dev)
# Set NEXT_PUBLIC_CONVEX_URL to your deployment's URL, e.g.
#   https://gregarious-porcupine-970.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# Clerk Authentication (https://dashboard.clerk.com)
# Non-secret publishable key — safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key — server-only, keep private.
CLERK_SECRET_KEY=

# Liveblocks (https://liveblocks.io/dashboard)
# Secret key used by the /api/liveblocks-auth route to mint access tokens.
LIVEBLOCKS_SECRET_KEY=